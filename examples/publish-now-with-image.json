{
  "name": "PostSider: Publish Now With an Image",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "When Clicking Execute Workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://postsider.com/og-image.png",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "download-image",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "publish",
        "channels": ["REPLACE_WITH_CHANNEL_ID"],
        "text": "Published from n8n with PostSider.",
        "when": "now",
        "mediaSource": "binary",
        "binaryProperties": "data",
        "options": {
          "waitForResult": true,
          "waitTimeout": 60
        }
      },
      "id": "publish-now",
      "name": "Publish Now",
      "type": "n8n-nodes-postsider.postSider",
      "typeVersion": 2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "When Clicking Execute Workflow": {
      "main": [[{ "node": "Download Image", "type": "main", "index": 0 }]]
    },
    "Download Image": {
      "main": [[{ "node": "Publish Now", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "postsider-example-publish-now-v1"
}
